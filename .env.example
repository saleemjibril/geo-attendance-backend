PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/attendance

ADMIN_JWT_SECRET=use-a-long-random-string
# One-time: create first admin in MongoDB (also auto-runs on startup if no admins exist)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me

# Comma-separated if you run the React app on another port during dev
CORS_ORIGIN=http://localhost:3000

# Building / geofence center (WGS84). Get from Google Maps: right-click → coordinates.
ATTENDANCE_LAT=
ATTENDANCE_LNG=
ATTENDANCE_RADIUS_METERS=100
ATTENDANCE_MAX_GPS_ACCURACY_METERS=80
ATTENDANCE_VENUE_NAME=Main building
# Local testing only (ignored when NODE_ENV=production):
# ATTENDANCE_DISABLE_GEOFENCE=true
# Optional IANA timezone for "one check-in per calendar day" (e.g. Africa/Lagos)
# ATTENDANCE_TIMEZONE=
